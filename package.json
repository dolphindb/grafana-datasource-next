{
  "name": "dolphindb-datasource-next",
  "version": "3.0.8",
  "description": "Dolphin db grafana datasource",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "npm run lint -- --fix",
    "e2e": "playwright test",
    "package:release": "bash ./scripts/package-release.sh",
    "server": "docker compose up --build --force-recreate",
    "server:build": "docker compose build --pull grafana",
    "server:up": "docker compose up --build --force-recreate",
    "server:up:detached": "docker compose up --build --force-recreate --detach",
    "server:stop": "docker compose stop grafana",
    "server:down": "docker compose down --remove-orphans",
    "server:logs": "docker compose logs --follow grafana",
    "server:restart": "docker compose up --build --force-recreate --detach grafana",
    "server:config": "docker compose config --quiet",
    "sign": "npx --yes @grafana/sign-plugin@latest"
  },
  "author": "Dolphin db",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@grafana/eslint-config": "^7.0.0",
    "@grafana/plugin-e2e": "^3.4.8",
    "@grafana/plugin-meta-extractor": "^0.12.2",
    "@grafana/tsconfig": "^2.0.1",
    "@playwright/test": "^1.41.2",
    "@svgr/webpack": "^8.1.0",
    "@swc/core": "^1.3.90",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.26",
    "@testing-library/jest-dom": "6.1.4",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.0",
    "@types/lodash": "^4.14.194",
    "@types/node": "^20.8.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-router-dom": "^5.2.0",
    "@types/sass-loader": "^8.0.8",
    "@types/testing-library__jest-dom": "5.14.8",
    "@types/webpack-sources": "^3.2.3",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.3",
    "eslint": "^8.57.0",
    "eslint-plugin-deprecation": "^2.0.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-xlint": "^1.0.13",
    "eslint-webpack-plugin": "^4.0.1",
    "fork-ts-checker-webpack-plugin": "^8.0.0",
    "glob": "^10.2.7",
    "identity-obj-proxy": "3.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "license-webpack-plugin": "^4.0.2",
    "prettier": "^2.8.7",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "1.63.2",
    "sass-loader": "13.3.1",
    "source-map": "^0.7.4",
    "source-map-loader": "^5.0.0",
    "style-loader": "3.3.3",
    "swc-loader": "^0.2.3",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "webpack": "^5.86.0",
    "webpack-cli": "^5.1.4",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-merge": "^6.0.1",
    "webpack-sources": "^3.2.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "13.2.2",
    "@grafana/runtime": "13.2.2",
    "@grafana/schema": "13.2.2",
    "@grafana/ui": "13.2.2",
    "dayjs": "^1.11.11",
    "dayjs-plugin-utc": "^0.1.2",
    "dolphindb": "^2.0.1103",
    "monaco-editor": "^0.47.0",
    "re-resizable": "^6.9.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rxjs": "7.8.2",
    "tslib": "^2.8.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0",
    "xshell": "^1.0.84"
  },
  "packageManager": "npm@10.5.2"
}
